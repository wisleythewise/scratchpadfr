<?xml version="1.0" encoding="utf-8"?>

<robot name="fr_max" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find fr-max)/urdf/macros.xacro" />
    
    <link name="base_footprint">
        <!-- <visual>
            <geometry>
                <sphere radius="0.001" />
            </geometry>
        </visual> -->
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://fr-max/meshes/FR-max-chassis.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="-0.8 -0.41 -0.051" rpy="0 0 0" />
            <material name="yellow">
                <color rgba="0.8 0.3 0.1 0.5" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="1.6 0.82 0.03" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </collision>
        <inertial>
            <mass value="136.0"/>
            <inertia
                ixx="10.58"   ixy="0.0"    ixz="0.0"
                iyy="32.31"   iyz="0.0"
                izz="37.36"
            />
        </inertial>

    </link>

    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link"/>
        <origin xyz="0 0 0.032" />
    </joint>




    <link name="left_steering_hinge">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.5" /> 
            <inertia 
                ixx="6.75E-05" 
                ixy="0" 
                ixz="0" 
                iyy="6.75E-05" 
                iyz="0" 
                izz="1.25E-04" 
            />
        </inertial>
        <!-- <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial> -->
    </link>


    <joint name="left_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="left_steering_hinge" />
        <origin xyz="0.425 0.3075 0.183" />
        <axis xyz="0 0 1" />
        <limit lower="-0.4363" upper="0.4363" effort="100.0" velocity="100.0"/>
    </joint>



    <link name="left_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fr-max/meshes/luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.995 0.05 -0.23" rpy="0 0 3.14" />
            <material name="black">
                <color rgba="0.8 0.3 0.1 0.5" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.21" length="0.12" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" /> 
            <mass value="5.0" />
            <inertia 
                ixx="0.0611" ixy="0" ixz="0" 
                iyy="0.0611" iyz="0" 
                izz="0.1103" 
            />
        </inertial>
        <!-- <inertial>
            <origin xyz="0 0 0" />
            <mass value="5.0" />
            <inertia ixx="6.64E-04" ixy="0" ixz="0" iyy="6.64E-04" iyz="0" izz="1.02E-03" />
        </inertial> -->
    </link>

    <joint name="left_front_wheel_joint" type="continuous">
        <parent link="left_steering_hinge" />
        <child link="left_front_wheel" />
        <origin xyz="0 0.025 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="1000" />
    </joint>


    <link name="right_steering_hinge">
        <visual>
            <geometry>
                 <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.005" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />
            <mass value="2.5" /> 
            <inertia 
                ixx="6.75E-05" 
                ixy="0" 
                ixz="0" 
                iyy="6.75E-05" 
                iyz="0" 
                izz="1.25E-04" 
            />
        </inertial>
        <!-- <inertial>
            <origin xyz="0 0 0" />
            <mass value="1" />
            <inertia ixx="2.7E-05" ixy="0" ixz="0" iyy="2.7E-05" iyz="0" izz="5E-05" />
        </inertial> -->
    </link>

    <joint name="right_steering_hinge_joint" type="revolute">
        <parent link="base_link" />
        <child link="right_steering_hinge" />
        <origin xyz="0.425 -0.3075 0.183" />
        <axis xyz="0 0 1" />
        <limit lower="-0.4363" upper="0.4363" effort="100.0" velocity="100.0"/>
    </joint>


    <link name="right_front_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fr-max/meshes/luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.995 -0.05 0.23" rpy="0 3.14 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.21" length="0.12" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />  <!-- 质心位于几何中心 -->
            <mass value="5.0" />
            <inertia 
                ixx="0.0611" ixy="0" ixz="0" 
                iyy="0.0611" iyz="0" 
                izz="0.1103" 
            />
        </inertial>
    </link>

    <joint name="right_front_wheel_joint" type="continuous">
        <parent link="right_steering_hinge" />
        <child link="right_front_wheel" />
        <origin xyz="0 -0.025 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="1000" />
    </joint>




    <link name="left_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fr-max/meshes/luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="0.995 0.05 -0.23" rpy="0 0 3.14" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.21" length="0.12" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />  <!-- 质心位于几何中心 -->
            <mass value="5.0" />
            <inertia 
                ixx="0.0611" ixy="0" ixz="0" 
                iyy="0.0611" iyz="0" 
                izz="0.1103" 
            />
        </inertial>
    </link>

    <joint name="left_rear_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_rear_wheel" />
        <origin xyz="-0.425 0.3325 0.183" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>




    <link name="right_rear_wheel">
        <visual>
            <geometry>
                <mesh filename="package://fr-max/meshes/luntai.STL" scale="1 1 1"/>
            </geometry>
            <origin xyz="-0.995 -0.05 -0.23" rpy="0 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.21" length="0.12" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" />  <!-- 质心位于几何中心 -->
            <mass value="5.0" />
            <inertia 
                ixx="0.0611" ixy="0" ixz="0" 
                iyy="0.0611" iyz="0" 
                izz="0.1103" 
            />
        </inertial>
    </link>

    <joint name="right_rear_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_rear_wheel" />
        <origin xyz="-0.425 -0.3325 0.183" />
        <axis xyz="0 1 0" />
        <limit effort="10" velocity="1000" />
    </joint>

  <xacro:include filename="$(find fr-max)/urdf/fr-max.gazebo" />

</robot>